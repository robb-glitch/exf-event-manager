# Copy these into Railway > your service > Variables. Never commit real values.
DATABASE_URL=            # Railway: add a Reference to the Postgres service's DATABASE_URL
SESSION_SECRET=          # any long random string
ACCESS_CODE=             # the team code colleagues type to sign in
ADMIN_EMAILS=robb@qurogroup.com   # comma list. These people are "owner" in the app
ADMIN_PASSWORD=          # password for /admin (partner submissions page)
NOTIFY_EMAIL=rdoduck@exfreight.com
RESEND_API_KEY=          # from resend.com
MAIL_FROM=ExFreight Partners <onboarding@resend.dev>   # change after verifying your domain in Resend
ANTHROPIC_API_KEY=       # from console.anthropic.com (card reading)
ANTHROPIC_MODEL=claude-sonnet-4-5
BASE_URL=                # your public address, e.g. https://exf-event-manager.up.railway.app
